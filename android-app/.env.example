# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# BACKEND_BASE_URL: Production server URL for Business Manager cloud sync & auth.
# Encrypted at build time into the APK using the package name (never shown in app UI).
BACKEND_BASE_URL=https://ledger.hassanagro.com/

# APP_CLIENT_SECRET: 64-char secret key generated in the Laravel Admin Panel (Settings -> Mobile App Security).
# Encrypted at build time into the APK and used to sign every API request with HMAC-SHA256.
APP_CLIENT_SECRET=REPLACE_WITH_ADMIN_PANEL_APP_KEY

# Optional WebSocket URL for instant push sync notifications (encrypted at build time if provided).
# BACKEND_WS_URL=
