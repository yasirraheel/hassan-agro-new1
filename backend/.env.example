APP_NAME="Hassan Agro Sync API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456_hassanagro
DB_USERNAME=u123456_user
DB_PASSWORD=replace_with_db_password

# Paste this exact same token into Hassan Agro App -> Settings -> Server Sync -> API Key / Token
SYNC_API_TOKEN=replace-with-a-long-random-secret-token

# Set a unique password before exposing the admin dashboard.
ADMIN_EMAIL=admin@hassanagro.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
